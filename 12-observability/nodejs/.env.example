# .env — 密钥与机器相关的运行时参数
# 行为规则（沙箱模式、工具权限、迭代次数等）请放 xclaw.yaml，不要放这里。

# ── LLM Provider（至少填一个）────────────────────────────────
# OpenAI兼容接口（如DeepSeek、Ollama、Azure OpenAI、各类国产大模型服务等）
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=GLM-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Full Sandbox Mode（xclaw.yaml sandbox.mode=full 时必填）──
E2B_API_URL=http://127.0.0.1:3000
E2B_API_KEY=dummy
CUBE_TEMPLATE_ID=
CUBE_SANDBOX_DOMAIN=          # 留空则从 E2B_API_URL 自动推导

# ── 进程权限降级（Linux/macOS Host Mode，留空=不降级）────────
AGENT_RUN_UID=
AGENT_RUN_GID=

# ── Web 通道端口 ───────────────────────────────────────────
WEB_PORT=3000
WEBHOOK_PORT=3001
WEBHOOK_SECRET=hook-secret

# ── QQ 通道（不填则跳过）─────────────────────────────────────
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_NOTIFY_OPENID=
QQ_NOTIFY_TYPE=c2c
QQ_SANDBOX=true # 是否使用 QQ 沙箱环境（仅测试用，生产请设置为 false）
